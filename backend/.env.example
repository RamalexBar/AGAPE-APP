# ── Entorno ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# ── JWT ──────────────────────────────────────────────────────────────
# IMPORTANTE: estos nombres deben coincidir EXACTAMENTE con env.js
# Usa strings aleatorios de 64+ caracteres (ej: openssl rand -base64 64)
JWT_ACCESS_SECRET=cambia_esto_minimo_64_caracteres_aleatorios_AAAA
JWT_REFRESH_SECRET=cambia_esto_otro_minimo_64_caracteres_aleatorios_BBBB
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Apple IAP (App Store Connect → My Apps → In-App Purchases) ───────
# App Store Connect → App → In-App Purchases → App-Specific Shared Secret
APPLE_IAP_SHARED_SECRET=tu_shared_secret_aqui
# Opcional, default 'com.agape.app' (debe coincidir con frontend/app.json → ios.bundleIdentifier)
# APPLE_BUNDLE_ID=com.agape.app
# Además, descargar los certificados raíz de Apple en backend/certs/apple/ (ver README ahí)
# para que se pueda verificar la firma de los webhooks — sin esto, /api/webhooks/apple falla.

# ── Google Play Billing ───────────────────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.agape.app
# Service Account JSON: Google Play Console → Setup → API access → Service account
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Requerido en producción para verificar que las notificaciones a
# /api/webhooks/google realmente vienen de Google Cloud Pub/Sub. Configurar al
# crear la suscripción push con --push-auth-token-audience=<esta misma URL>.
# GOOGLE_PUBSUB_AUDIENCE=https://tu-backend.com/api/webhooks/google
# Opcional: restringe a una service account específica de Pub/Sub.
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com

# ── Firebase Push Notifications ──────────────────────────────────────
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ── Agora (videollamadas reales — console.agora.io) ───────────────────
# Sin estas dos variables, /api/videocall/* devuelve app_id/token nulos
# y la app cae automáticamente a "modo demo" (sin video real).
AGORA_APP_ID=tu_app_id_de_agora
AGORA_APP_CERTIFICATE=tu_app_certificate_de_agora

# ── SMTP (envío de correos: recuperación de contraseña, etc.) ────────
# Cualquier proveedor SMTP sirve: Resend, SendGrid, Amazon SES, Gmail...
# Si se dejan vacías, los correos solo se registran en el log (modo dev).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=tu_api_key_o_password_smtp
SMTP_FROM="Ágape <no-reply@agapeapp.co>"

# ── URLs legales (deben ser públicas y accesibles vía HTTPS) ─────────
PRIVACY_POLICY_URL=https://tudominio.com/privacy
TERMS_OF_SERVICE_URL=https://tudominio.com/terms

# ── Wompi (pagos en pesos colombianos) ────────────────────────────────
# Wompi Dashboard → Configuración → Llaves API
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_INTEGRITY_KEY=tu_llave_de_integridad
# Dashboard → Configuración → Eventos — usada para verificar la firma del webhook
WOMPI_EVENTOS=tu_llave_de_eventos
APP_URL=https://tudominio.com
